NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente servidor. Necessária para exclusão definitiva de contas.
# Use a Secret key atual (recomendado). Nunca use NEXT_PUBLIC_ neste valor.
SUPABASE_SECRET_KEY=

# Compatibilidade opcional com projetos que ainda usam a chave legada:
# SUPABASE_SERVICE_ROLE_KEY=
